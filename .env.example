# Copy to .env.local and fill in. Never commit real values.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — keep it out of anything that reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Reseta
# The app's own hostname, e.g. app.reseta.ph. Any request on a different host
# is treated as a tenant's custom storefront domain. Leave unset to disable.
NEXT_PUBLIC_PRIMARY_HOST=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Billing (Xendit scaffold) -------------------------------------------
NEXT_PUBLIC_BILLING_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- AI receipt scanning --------------------------------------------------
# Optional. The feature is hidden when this is absent.
ANTHROPIC_API_KEY=

# --- Platform admin -------------------------------------------------------
# Comma-separated emails granted super-admin access to /admin.
PLATFORM_ADMIN_EMAILS=

# --- CANVEXIA agent portal ------------------------------------------------
# Referred signups, submitted payments and cancellations are reported to the
# agent portal; it tells us back about signed agreements and confirmed
# payments. All three must be set for anything to be sent — with any of them
# missing, events simply queue in product_event_outbox and go out once they
# are configured. Nothing here is required for an account without an agent
# code, and no commission logic lives in this product.
#
# Register this URL with the portal as Reseta's callback:
#   https://<your-host>/api/portal/callback
AGENT_PORTAL_URL=https://canvexia-agent-portal.vercel.app
AGENT_PORTAL_PRODUCT_SLUG=reseta
# Server-only shared secret. Signs our requests and verifies the portal's
# callbacks. Get it from the portal's product settings.
AGENT_PORTAL_SECRET=

# --- Cron -----------------------------------------------------------------
# Vercel sends this as a bearer token on scheduled invocations. Set it in
# production to stop anyone else triggering the outbox worker.
CRON_SECRET=
